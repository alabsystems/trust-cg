smt2 318
(set-option :timeout 30000)
(set-option :produce-models true)
(set-logic QF_BV)
(declare-const recon_src1 (_ BitVec 32))
(declare-const recon_src2 (_ BitVec 32))
(assert (and (bvult recon_src2 (_ bv32 32)) (not (= (bvashr recon_src1 recon_src2) (bvashr recon_src1 (bvand (_ bv31 32) recon_src2))))))
(check-sat)
(exit)
