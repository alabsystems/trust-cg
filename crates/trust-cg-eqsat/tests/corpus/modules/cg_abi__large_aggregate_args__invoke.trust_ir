; TrustIr text format v1
module "large_aggregate_invoke"
target "aarch64-unknown-linux-gnu" 8 little abi="aapcs64"

struct @Quad { q0: i64 @0, q1: i64 @8, q2: i64 @16, q3: i64 @24 } size=32 align=8 repr=c id=0

struct @Big { g: [ty.0 x 40] @0 } size=320 align=8 repr=c id=1

struct @Giant { g: [ty.0 x 9000] @0 } size=72000 align=8 repr=c id=2

functy.0 = (struct.0, i64) -> (i64)

functy.1 = (struct.1, i64) -> (i64)

functy.2 = (struct.2, i64) -> (i64)

functy.3 = (ptr) -> (ptr)

functy.4 = () -> ()

functy.5 = (ptr, struct.0, i64) -> (i64)

functy.6 = (ptr, ptr, i64) -> (i64)

functy.7 = (ptr, i64) -> (i64)

type ty.0 = i64

fn @c_throw_quad(functy.0) {
}

fn @c_throw_big(functy.1) {
}

fn @c_throw_giant(functy.2) {
