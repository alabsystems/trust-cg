; TrustIr text format v1
module "drop_glue"
target "aarch64-apple-darwin" 8 little

struct @Resource { field: i64 @0 } size=8 align=8 id=0

struct @Pair { field: i64 @0 } size=8 align=8 id=1

struct @Node { field: ptr @0 } size=8 align=8 id=2

functy.0 = (ptr) -> ()

functy.1 = (bool) -> (i64)

functy.2 = () -> (i64)

drop_glue @func.0 struct.0

drop_glue @func.1 struct.1

drop_glue @func.2 struct.2

fn @drop_resource(functy.0) {
    ; #body-gate: ungated
bb0(%0: ptr):
    %1 = load i64, ptr %0
    %2 = const i64 1
    %3 = add i64 %1, %2
    store i64 %3, ptr %0
    ret
}

fn @drop_pair(functy.0) {
    ; #body-gate: ungated
bb0(%0: ptr):
    drop struct.0, %0
    ret
}

fn @drop_node(functy.0) {
    ; #body-gate: ungated
bb0(%0: ptr):
    %1 = load ptr, ptr %0
    %2 = ptrtoint ptr %1 to u64
    %3 = const u64 0
    %4 = icmp eq u64 %2, %3
    condbr %4, bb2, bb1
bb1:
    drop struct.2, %1
    ret
bb2:
    ret
}

fn @run(functy.1) {
    ; #body-gate: ungated
bb0(%0: bool):
    %1 = alloca i64
    %2 = const i64 0
    store i64 %2, ptr %1
    drop struct.0, %1
    drop struct.1, %1
    condbr %0, bb1, bb2
bb1:
    drop struct.0, %1
    br bb2
bb2:
    drop_invoke struct.1, %1 to bb3() unwind bb4
bb3:
    %3 = load i64, ptr %1
    ret %3
bb4:
    %4, %5 = landingpad cleanup
    resume %4
}

fn @run_list(functy.2) {
    ; #body-gate: ungated
bb0:
    %0 = null ptr
    %1 = alloca ptr
    store ptr %0, ptr %1
    %2 = alloca ptr
    store ptr %1, ptr %2
    drop struct.2, %2
    %3 = const i64 0
    ret %3
}
