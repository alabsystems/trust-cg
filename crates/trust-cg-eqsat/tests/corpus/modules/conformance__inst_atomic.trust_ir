    %12 = atomicrmw min seq_cst i64 ptr %0, %1
    %13 = atomicrmw umax seq_cst i64 ptr %0, %1
    %14 = atomicrmw umin seq_cst i64 ptr %0, %1
    %15 = const i64 0
    %16 = const i64 1
    %17, %18 = cmpxchg i64 ptr %0, %15, %16 acq_rel acquire
    %19 = const i64 0
    ret %19
}
