; TrustIr text format v1
module "b1_scalars"

functy.0 = (isize) -> (isize)

functy.1 = (usize) -> (usize)

functy.2 = () -> (char)

fn @isize_add_one(functy.0) {
bb0(%0: isize):
    %1 = const isize 1
    %2 = add isize %0, %1
    ret %2
}

fn @usize_id(functy.1) {
bb0(%0: usize):
    ret %0
}

fn @char_a(functy.2) {
bb0:
    %0 = const char 65
    ret %0
}
