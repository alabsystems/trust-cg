module "inst_vector_crosslane"

functy.0 = (<4 x i32>, <2 x i64>, <4 x f32>, <2 x f64>) -> (i32, i64, <4 x i32>, <2 x i64>, <4 x f32>, <2 x f64>)

fn @portable_vector_crosslane(functy.0) {
bb0(%0: <4 x i32>, %1: <2 x i64>, %2: <4 x f32>, %3: <2 x f64>):
    %4 = dialect_op vector.reduce(%0) -> i32 [vector_ty=ty:<4 x i32>] [kind=str:"add"]
    %5 = dialect_op vector.reduce(%1) -> i64 [vector_ty=ty:<2 x i64>] [kind=str:"or"]
    %6 = dialect_op vector.shuffle(%0) -> <4 x i32> [indices=bytes:4:03020100]
