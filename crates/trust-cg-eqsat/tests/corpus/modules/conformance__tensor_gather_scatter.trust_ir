; TrustIr text format v1
module "tensor_gather_scatter"
target "aarch64-apple-darwin" 8 little structpass=unclassified

functy.0 = (tensor<i32, 2>, tensor<i64, 1>, tensor<u8, 1>, tensor<i32, 1>, tensor<usize, 1>) -> (tensor<i32, 1>)

fn @gs(functy.0) {
    ; #body-gate: ungated
bb0(%0: tensor<i32, 2>, %1: tensor<i64, 1>, %2: tensor<u8, 1>, %3: tensor<i32, 1>, %4: tensor<usize, 1>):
    %5 = tensor_gather tensor<i32, 1> %0 coords [%1, %2]
    %6 = tensor_scatter tensor<i32, 1> %3, %5 coords [%4]
    ret %6
}
