; TrustIr text format v1
module "inst_wire_batch"

enum @E { A(i32, bool), B } id=0

functy.0 = (i32, bool) -> (enum.0, (i32, bool), enum.0)

functy.1 = (ptr, ptr, u64, u8) -> ()

functy.2 = (u32, u32) -> (u32)

functy.3 = (f64, f64) -> (f64)

fn @make(functy.0) {
    ; #body-gate: ungated
bb0(%0: i32, %1: bool):
    %2 = make_aggregate enum.0 variant 0 (%0, %1)
    %3 = make_aggregate (i32, bool) (%0, %1)
    %4 = make_aggregate enum.0 variant 1 ()
    ret %2, %3, %4
}

fn @copy(functy.1) {
    ; #body-gate: ungated
bb0(%0: ptr, %1: ptr, %2: u64, %3: u8):
    memcopy ptr %0, ptr %1, %2
    memcopy overlap ptr %0, ptr %1, %2
    memset ptr %0, %3, %2
    ret
}

fn @bits(functy.2) {
    ; #body-gate: ungated
bb0(%0: u32, %1: u32):
    %2 = ctlz u32 %0
    %3 = cttz u32 %2
    %4 = bswap u32 %3
    %5 = bitreverse u32 %4
    %6 = rotl u32 %5, %1
    %7 = rotr u32 %6, %1
    ret %7
}

fn @sign(functy.3) {
    ; #body-gate: ungated
bb0(%0: f64, %1: f64):
    %2 = fcopysign f64 %0, %1
    ret %2
}
