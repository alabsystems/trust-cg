; TrustIr text format v1
module "mixed_producer_module"

functy.0 = (i32) -> (i32)

fn @clean_double(functy.0) {
    ; #producer: clean
bb0(%0: i32):
    %1 = const i32 2
    %2 = mul i32 %0, %1
    ret %2
}

fn @trust_inc(functy.0) {
    ; #producer: trust
bb0(%0: i32):
    %1 = const i32 1
    %2 = add i32 %0, %1
    ret %2
}

fn @trust_calls_clean(functy.0) {
    ; #producer: trust
bb0(%0: i32):
    %1 = call @func.0(%0)
    %2 = const i32 1
    %3 = add i32 %1, %2
    ret %3
}

fn @clean_calls_trust(functy.0) {
    ; #producer: clean
bb0(%0: i32):
    %1 = call @func.1(%0)
    %2 = const i32 2
    %3 = mul i32 %1, %2
    ret %3
}
