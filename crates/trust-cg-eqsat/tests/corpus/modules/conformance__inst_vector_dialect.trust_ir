; TrustIr text format v1
module "inst_vector_dialect"

functy.0 = (i32, i32, i32, i32, i64, i64, <4 x i32>, i32, <2 x i64>, i64, <8 x bool>, <16 x bool>) -> (<4 x i32>, i32, <4 x i32>, <2 x i64>, i64, <2 x i64>, i32, i64, i32, i32)

fn @portable_vector_dialect(functy.0) {
bb0(%0: i32, %1: i32, %2: i32, %3: i32, %4: i64, %5: i64, %6: <4 x i32>, %7: i32, %8: <2 x i64>, %9: i64, %10: <8 x bool>, %11: <16 x bool>):
    %12 = dialect_op vector.pack_lanes(%0, %1, %2, %3) -> <4 x i32>
    %13 = dialect_op vector.extract_lane(%12) -> i32 [vector_ty=ty:<4 x i32>] [lane=u64:2]
    %14 = dialect_op vector.insert_lane(%6, %7) -> <4 x i32> [lane=u64:1]
    %15 = dialect_op vector.pack_lanes(%4, %5) -> <2 x i64>
    %16 = dialect_op vector.extract_lane(%15) -> i64 [vector_ty=ty:<2 x i64>] [lane=u64:1]
    %17 = dialect_op vector.insert_lane(%8, %9) -> <2 x i64> [lane=u64:0]
    %18 = icmp sgt <4 x i32> %14, %12
    %19 = dialect_op vector.mask_to_bits(%18) -> i32 [mask_ty=ty:<4 x bool>] [bit_order=str:"lsb_lane0"]
    %20 = icmp eq <2 x i64> %17, %15
    %21 = dialect_op vector.mask_to_bits(%20) -> i64 [mask_ty=ty:<2 x bool>] [bit_order=str:"lsb_lane0"]
    %22 = dialect_op vector.mask_to_bits(%10) -> i32 [mask_ty=ty:<8 x bool>] [bit_order=str:"lsb_lane0"]
    %23 = dialect_op vector.mask_to_bits(%11) -> i32 [mask_ty=ty:<16 x bool>] [bit_order=str:"lsb_lane0"]
    ret %12, %13, %14, %15, %16, %17, %19, %21, %22, %23
}
