; TrustIr text format v1
; WS7.1 adversarial value-semantics corpus. Every function takes and returns
; u64 so the trust-ir reference interpreter is an exact oracle; the expected
; closed forms are asserted by tests/insert_field_value_semantics.rs.
module "ws7_1-adversarial"

struct @Pt { u64, u64 } id=0

type ty.0 = u64

functy.0 = (u64) -> (u64)

functy.1 = (struct.0) -> (u64)

functy.2 = (u64, u64) -> (u64)

; A loop that carries an aggregate header parameter and reads the OLD value
; (through a copy) after the insert that builds the next one.
; loop_old_after_update(n) = sum_{k<n} k = n*(n-1)/2   (n >= 1)
fn @loop_old_after_update(functy.0) {
bb0(%0: u64):
    %1 = const struct.0 { 0, 9 }
    %2 = const u64 0
    br bb1(%1, %2, %2)
bb1(%3: struct.0, %4: u64, %5: u64):
    %6 = copy struct.0 %3
    %7 = extractfield u64 %3, 0
    %8 = const u64 1
    %9 = add u64 %7, %8
    %10 = insertfield struct.0 %3, 0, %9
    %11 = extractfield u64 %6, 0
    %12 = add u64 %5, %11
    %13 = add u64 %4, %8
    %14 = icmp ult u64 %13, %0
    condbr %14, bb1(%10, %13, %12), bb2(%12)
bb2(%15: u64):
    ret %15
}

; An aggregate block-parameter SWAP, with an insert on one of the swapped
; values whose OLD value is read afterwards.
; swap_loop(n) for n >= 1: the pair starts (a={1,0}, b={2,0}); each iteration
; accumulates the OLD a.0 + a.1, builds a' = a with .1 := i and continues with
; (b, a'). Result = acc*1000 + a'.0*10 + b.0 of the last iteration.
fn @swap_loop(functy.0) {
bb0(%0: u64):
    %1 = const struct.0 { 1, 0 }
    %2 = const struct.0 { 2, 0 }
    %3 = const u64 0
    br bb1(%1, %2, %3, %3)
bb1(%4: struct.0, %5: struct.0, %6: u64, %7: u64):
    %8 = insertfield struct.0 %4, 1, %6
    %9 = extractfield u64 %4, 0
    %10 = extractfield u64 %4, 1
    %11 = add u64 %7, %9
    %12 = add u64 %11, %10
    %13 = const u64 1
    %14 = add u64 %6, %13
    %15 = icmp ult u64 %14, %0
    condbr %15, bb1(%5, %8, %14, %12), bb2(%8, %5, %12)
bb2(%16: struct.0, %17: struct.0, %18: u64):
    %19 = extractfield u64 %16, 0
    %20 = extractfield u64 %17, 0
    %21 = const u64 1000
    %22 = mul u64 %18, %21
    %23 = const u64 10
    %24 = mul u64 %19, %23
    %25 = add u64 %22, %24
    %26 = add u64 %25, %20
    ret %26
}

; A loop-carried aggregate LOAD whose pointee is stored to inside the loop,
; with the parameter read after the re-load. The parameter must hold the
; value loaded on the PREVIOUS iteration (a view of the re-loaded slot would
; see the current one).
; loop_carried_load(n) = (n-1)*(n-2)/2   (n >= 1)
fn @loop_carried_load(functy.0) {
bb0(%0: u64):
    %1 = alloca struct.0
    %2 = const struct.0 { 0, 0 }
    store struct.0 %2, ptr %1
    %3 = load struct.0, ptr %1
    %4 = const u64 0
    br bb1(%3, %4, %4)
bb1(%5: struct.0, %6: u64, %7: u64):
    %8 = load struct.0, ptr %1
    %9 = const u64 1
    %10 = add u64 %6, %9
    store u64 %10, ptr %1
    %11 = extractfield u64 %5, 0
    %12 = add u64 %7, %11
    %13 = icmp ult u64 %10, %0
    condbr %13, bb1(%8, %10, %12), bb2(%12)
bb2(%14: u64):
    ret %14
}

; An insert whose base is a function PARAMETER: the parameter itself (read
; again after the insert) and the caller's argument must both keep their value.
; param_base_callee(s) = s'.0 + s.0*1000 + s'.1 where s' = s with .0 := 100
rustcc fn @param_base_callee(functy.1) {
bb0(%0: struct.0):
    %1 = const u64 100
    %2 = insertfield struct.0 %0, 0, %1
    %3 = extractfield u64 %2, 0
    %4 = extractfield u64 %2, 1
    %5 = add u64 %3, %4
    %6 = extractfield u64 %0, 0
    %7 = const u64 1000
    %8 = mul u64 %6, %7
    %9 = add u64 %5, %8
    ret %9
}

; param_base_caller(x) = x*1000 + (100 + x*1000 + 5) = 2000*x + 105
rustcc fn @param_base_caller(functy.0) {
bb0(%0: u64):
    %1 = const struct.0 { 0, 5 }
    %2 = insertfield struct.0 %1, 0, %0
    %3 = call @func.3(%2)
    %4 = extractfield u64 %2, 0
    %5 = const u64 1000
    %6 = mul u64 %4, %5
    %7 = add u64 %6, %3
    ret %7
}

; `insertelement` on an array, reading the SOURCE array after the update.
; array_insert_element(x, i) = a[i]*1000 + a2[i], a = [7, 8], a2 = a[i := x]
fn @array_insert_element(functy.2) {
bb0(%0: u64, %1: u64):
    %2 = const [ty.0 x 2] array[ 7, 8 ]
    %3 = insertelement [ty.0 x 2] %2, %1, %0
    %4 = extractelement u64 %2, %1
    %5 = extractelement u64 %3, %1
    %6 = const u64 1000
    %7 = mul u64 %4, %6
    %8 = add u64 %7, %5
    ret %8
}
