; TrustIr text format v1
; WS7.1 (b) negative fixture: the STORE FORM of insertfield: the aggregate
; operand is a POINTER whose pointee the producer expects to be updated in
; place. trust-ir defines only the value form (the validator refuses this with
; FieldAccessInvalid; the interpreter answers TypeError), and trust-cg must
; refuse it by name rather than give it either meaning.
module "ws7_1-store-form"

struct @Pt { u64, u64 } id=0

functy.0 = (u64) -> (u64)

fn @store_form(functy.0) {
bb0(%0: u64):
    %1 = alloca struct.0
    %2 = const struct.0 { 0, 0 }
    store struct.0 %2, ptr %1
    %3 = insertfield struct.0 %1, 0, %0
    %4 = load struct.0, ptr %1
    %5 = extractfield u64 %4, 0
    ret %5
}
