; TrustIr text format v1
; WS7.2 differential corpus: the WS7.1 aggregate value-semantics families,
; written so every entry point takes and returns scalars. The oracle is the
; trust-ir reference interpreter (tests/trust_ir_interp_differential.rs); no
; expected value is stated here.
module "ws7_2-value-semantics-families"

struct @Pt { u64, u64 } id=0

struct @Outer { u64, struct.0 } id=1

struct @Packed { u8, u64, u16 } repr=packed(1) id=2

type ty.0 = u64

functy.0 = (u64) -> (u64)

functy.1 = (struct.0) -> (u64)

functy.2 = (u64, u64) -> (u64)

; An aggregate loop header parameter; the OLD value is read after the insert
; that builds the next iteration's value.
fn @loop_old_after_update(functy.0) {
bb0(%0: u64):
    %1 = const struct.0 { 0, 9 }
    %2 = const u64 0
    br bb1(%1, %2, %2)
bb1(%3: struct.0, %4: u64, %5: u64):
    %6 = extractfield u64 %3, 0
    %7 = const u64 1
    %8 = add u64 %6, %7
    %9 = insertfield struct.0 %3, 0, %8
    %10 = extractfield u64 %3, 0
    %11 = add u64 %5, %10
    %12 = add u64 %4, %7
    %13 = icmp ult u64 %12, %0
    condbr %13, bb1(%9, %12, %11), bb2(%11)
bb2(%14: u64):
    ret %14
}

; A block-parameter SWAP of two aggregates, one of which is updated by an
; insert whose source is read afterwards.
fn @swap_loop(functy.0) {
bb0(%0: u64):
    %1 = const struct.0 { 1, 0 }
    %2 = const struct.0 { 2, 0 }
    %3 = const u64 0
    br bb1(%1, %2, %3, %3)
bb1(%4: struct.0, %5: struct.0, %6: u64, %7: u64):
    %8 = insertfield struct.0 %4, 1, %6
    %9 = extractfield u64 %4, 0
    %10 = extractfield u64 %4, 1
    %11 = add u64 %7, %9
    %12 = add u64 %11, %10
    %13 = const u64 1
    %14 = add u64 %6, %13
    %15 = icmp ult u64 %14, %0
    condbr %15, bb1(%5, %8, %14, %12), bb2(%8, %5, %12)
bb2(%16: struct.0, %17: struct.0, %18: u64):
    %19 = extractfield u64 %16, 0
    %20 = extractfield u64 %17, 0
    %21 = const u64 1000
    %22 = mul u64 %18, %21
    %23 = const u64 10
    %24 = mul u64 %19, %23
    %25 = add u64 %22, %24
    %26 = add u64 %25, %20
    ret %26
}

; A loop-carried aggregate LOAD whose slot is stored to inside the loop: the
; parameter holds the PREVIOUS iteration's loaded value.
fn @loop_carried_load(functy.0) {
bb0(%0: u64):
    %1 = alloca struct.0
    %2 = const struct.0 { 0, 0 }
    store struct.0 %2, ptr %1
    %3 = load struct.0, ptr %1
    %4 = const u64 0
    br bb1(%3, %4, %4)
bb1(%5: struct.0, %6: u64, %7: u64):
    %8 = load struct.0, ptr %1
    %9 = const u64 1
    %10 = add u64 %6, %9
    store u64 %10, ptr %1
    %11 = extractfield u64 %5, 0
    %12 = add u64 %7, %11
    %13 = icmp ult u64 %10, %0
    condbr %13, bb1(%8, %10, %12), bb2(%12)
bb2(%14: u64):
    ret %14
}

; An insert whose base is a by-value PARAMETER, read again after the insert.
rustcc fn @param_base_callee(functy.1) {
bb0(%0: struct.0):
    %1 = const u64 100
    %2 = insertfield struct.0 %0, 0, %1
    %3 = extractfield u64 %2, 0
    %4 = extractfield u64 %2, 1
    %5 = add u64 %3, %4
    %6 = extractfield u64 %0, 0
    %7 = const u64 1000
    %8 = mul u64 %6, %7
    %9 = add u64 %5, %8
    ret %9
}

; The caller's argument must keep its value across the call.
rustcc fn @param_base_caller(functy.0) {
bb0(%0: u64):
    %1 = const struct.0 { 0, 5 }
    %2 = insertfield struct.0 %1, 0, %0
    %3 = call @func.3(%2)
    %4 = extractfield u64 %2, 0
    %5 = const u64 1000
    %6 = mul u64 %4, %5
    %7 = add u64 %6, %3
    ret %7
}

; `insertelement` on an array whose SOURCE is read after the update. An index
; past the end is undefined behaviour in trust-ir: the differential skips that
; vector, and the entry still compares its in-range vectors.
fn @array_insert_element(functy.2) {
bb0(%0: u64, %1: u64):
    %2 = const [ty.0 x 2] array[ 7, 8 ]
    %3 = insertelement [ty.0 x 2] %2, %1, %0
    %4 = extractelement u64 %2, %1
    %5 = extractelement u64 %3, %1
    %6 = const u64 1000
    %7 = mul u64 %4, %6
    %8 = add u64 %7, %5
    ret %8
}

; A NESTED aggregate field: the inner value is extracted, updated and put
; back, and both the old outer value and the old inner value are read after.
fn @nested_field(functy.2) {
bb0(%0: u64, %1: u64):
    %2 = const struct.1 { 3, { 4, 5 } }
    %3 = extractfield struct.0 %2, 1
    %4 = insertfield struct.0 %3, 1, %0
    %5 = insertfield struct.1 %2, 1, %4
    %6 = insertfield struct.1 %5, 0, %1
    %7 = extractfield struct.0 %5, 1
    %8 = extractfield u64 %7, 1
    %9 = extractfield struct.0 %2, 1
    %10 = extractfield u64 %9, 1
    %11 = extractfield u64 %3, 1
    %12 = extractfield u64 %6, 0
    %13 = extractfield u64 %2, 0
    %14 = const u64 10
    %15 = mul u64 %8, %14
    %16 = add u64 %15, %10
    %17 = mul u64 %16, %14
    %18 = add u64 %17, %11
    %19 = mul u64 %18, %14
    %20 = add u64 %19, %12
    %21 = mul u64 %20, %14
    %22 = add u64 %21, %13
    ret %22
}

; A PACKED struct (byte-aligned u64 and u16 lanes): two inserts off one base,
; and the base read after both.
fn @packed_two_chains(functy.2) {
bb0(%0: u64, %1: u64):
    %2 = const struct.2 { 1, 2, 3 }
    %3 = insertfield struct.2 %2, 1, %0
    %4 = trunc u64 %1 to u16
    %5 = insertfield struct.2 %2, 2, %4
    %6 = extractfield u64 %3, 1
    %7 = extractfield u16 %5, 2
    %8 = zext u16 %7 to u64
    %9 = extractfield u64 %2, 1
    %10 = extractfield u16 %2, 2
    %11 = zext u16 %10 to u64
    %12 = extractfield u8 %5, 0
    %13 = zext u8 %12 to u64
    %14 = const u64 100000
    %15 = mul u64 %6, %14
    %16 = add u64 %15, %8
    %17 = mul u64 %16, %14
    %18 = add u64 %17, %9
    %19 = mul u64 %18, %14
    %20 = add u64 %19, %11
    %21 = add u64 %20, %13
    ret %21
}

; An insert whose base is a SELECT of two aggregates; both select operands
; are read after the insert.
fn @select_base(functy.2) {
bb0(%0: u64, %1: u64):
    %2 = const struct.0 { 10, 20 }
    %3 = const struct.0 { 30, 40 }
    %4 = const u64 0
    %5 = icmp ne u64 %0, %4
    %6 = select struct.0 %5, %2, %3
    %7 = insertfield struct.0 %6, 0, %1
    %8 = extractfield u64 %7, 0
    %9 = extractfield u64 %6, 0
    %10 = extractfield u64 %2, 0
    %11 = extractfield u64 %3, 0
    %12 = const u64 1000
    %13 = mul u64 %8, %12
    %14 = add u64 %13, %9
    %15 = mul u64 %14, %12
    %16 = add u64 %15, %10
    %17 = mul u64 %16, %12
    %18 = add u64 %17, %11
    ret %18
}
