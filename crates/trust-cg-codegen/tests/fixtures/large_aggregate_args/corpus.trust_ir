fn @k_block_pass(functy.8) {
bb0(%0: ptr, %1: ptr, %2: i64):
    %3 = load struct.8, ptr %1
    br bb1(%3)
bb1(%4: struct.8):
    %5 = call @func.22(%4, %2)
    store struct.8 %4, ptr %0
