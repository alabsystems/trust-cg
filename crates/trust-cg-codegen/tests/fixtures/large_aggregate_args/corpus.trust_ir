; TrustIr text format v1
; By-reference composite arguments (AAPCS64 B.4; DarwinPCS keeps the rule): a
; composite over 16 bytes that is not an HFA/HVA is passed as a pointer to a
; copy the CALLER allocates, and the callee may write that copy. The C callees
; in driver.c write every by-reference parameter they receive. Each function
; below stores the aggregates it passed into `out` after the calls, and the
; driver requires them unchanged, together with the digest the callee computed
; from the bytes it received. Shared by e2e_aarch64_large_aggregate_args_linux.
module "large_aggregate_args"
target "aarch64-unknown-linux-gnu" 8 little abi="aapcs64"

struct @Quad { q0: i64 @0, q1: i64 @8, q2: i64 @16, q3: i64 @24 } size=32 align=8 repr=c id=0
struct @Tri { t0: i64 @0, t1: i64 @8, t2: i64 @16 } size=24 align=8 repr=c id=1
struct @Odd { o0: i32 @0, o1: i32 @4, o2: i32 @8, o3: i32 @12, o4: i32 @16 } size=20 align=4 repr=c id=2
struct @Wide { w0: i128 @0, w1: i64 @16 } size=32 align=16 repr=c id=3
struct @Huge { h: [ty.0 x 40] @0 } size=320 align=8 repr=c id=4
struct @Hfa { d0: f64 @0, d1: f64 @8, d2: f64 @16, d3: f64 @24 } size=32 align=8 repr=c id=5
struct @Five { f: [ty.0 x 5] @0 } size=40 align=8 repr=c id=6
struct @Giant { g: [ty.0 x 9000] @0 } size=72000 align=8 repr=c id=7
struct @K { g: [ty.0 x 128] @0 } size=1024 align=8 repr=c id=8

type ty.0 = i64

functy.0 = (struct.0, i64) -> (i64)
functy.1 = (struct.0, struct.0, i64) -> (i64)
functy.2 = (i64, struct.0, i64, struct.1, f64, i64, struct.2, struct.5, i64, struct.3, struct.0, i64) -> (i64)
functy.3 = (struct.4, i64) -> (i64)
functy.4 = (struct.0, i64) -> (struct.0)
functy.5 = (i64, i64, i64, i64, i64, i64, i64, i64, struct.0, i64) -> (i64)
functy.6 = (ptr, struct.0, i64) -> (i64)
functy.7 = (ptr, i64) -> (i64)
functy.8 = (ptr, ptr, i64) -> (i64)
functy.9 = (ptr, i64, i64, i64, i64, i64, i64, i64, i64, struct.0, i64) -> (i64)
functy.10 = (ptr, struct.0, struct.1, struct.2, struct.3, struct.5, i64) -> (i64)
functy.11 = (ptr, struct.4, i64) -> (i64)
functy.12 = (ptr, ptr, struct.0, i64) -> (i64)
functy.13 = (ptr, struct.0, struct.0, i64, i64) -> (i64)
functy.14 = (struct.6, i64) -> (i64)
functy.15 = (struct.7, i64) -> (i64)
functy.16 = (struct.8, i64) -> (i64)
functy.17 = (ptr, struct.6, i64) -> (i64)
functy.18 = (ptr, struct.8, i64) -> (i64)

fn @c_mut_quad(functy.0) {
}

fn @c_mut_two(functy.1) {
}

fn @c_mut_mixed(functy.2) {
}

fn @c_mut_huge(functy.3) {
