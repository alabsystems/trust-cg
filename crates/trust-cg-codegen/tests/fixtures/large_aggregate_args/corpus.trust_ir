; A function parameter and a block parameter over 256 bytes forwarded as
; fixed arguments.
fn @k_param_pass(functy.18) {
bb0(%0: ptr, %1: struct.8, %2: i64):
    %3 = call @func.22(%1, %2)
    store struct.8 %1, ptr %0
    ret %3
