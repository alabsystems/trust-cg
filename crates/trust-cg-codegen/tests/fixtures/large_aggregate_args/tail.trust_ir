; TrustIr text format v1
; By-reference composite arguments in tail position. The copy a caller makes
; lives in its own frame, which a tail branch frees before the callee runs, so
; every call below that passes a composite over 16 bytes must keep its BL.
; `tail_scalar` is the control that does become a tail branch at O2/O3.
; Shared by e2e_aarch64_large_aggregate_args_linux.
module "large_aggregate_tail"
target "aarch64-unknown-linux-gnu" 8 little abi="aapcs64"

struct @Quad { q0: i64 @0, q1: i64 @8, q2: i64 @16, q3: i64 @24 } size=32 align=8 repr=c id=0
struct @Huge { h: [ty.0 x 40] @0 } size=320 align=8 repr=c id=1

type ty.0 = i64

functy.0 = (struct.0, i64) -> (i64)
functy.1 = (struct.1, i64) -> (i64)
functy.2 = (i64) -> (i64)

fn @c_mut_quad(functy.0) {
}

fn @c_mut_huge(functy.1) {
}

fn @c_scalar(functy.2) {
}

fn @tail_pass(functy.0) {
bb0(%0: struct.0, %1: i64):
    %2 = call @func.0(%0, %1)
    ret %2
}

fn @tail_const(functy.2) {
bb0(%0: i64):
    %1 = const struct.0 { 7, -8, 9, -10 }
    %2 = call @func.0(%1, %0)
    ret %2
}

fn @tail_huge(functy.1) {
bb0(%0: struct.1, %1: i64):
    %2 = call @func.1(%0, %1)
    ret %2
}

fn @tail_scalar(functy.2) {
bb0(%0: i64):
    %1 = call @func.2(%0)
    ret %1
}
