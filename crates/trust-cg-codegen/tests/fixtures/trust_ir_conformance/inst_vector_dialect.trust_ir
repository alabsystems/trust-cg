; trust_ir text format v1
module "inst_vector_dialect"

functy.0 = (i32, i32, i32, i32, i64, i64, <4 x i32>, i32, <2 x i64>, i64) -> (<4 x i32>, i32, <4 x i32>, <2 x i64>, i64, <2 x i64>, i32, i64)

fn @portable_vector_dialect(functy.0) {
bb0(%0: i32, %1: i32, %2: i32, %3: i32, %4: i64, %5: i64, %6: <4 x i32>, %7: i32, %8: <2 x i64>, %9: i64):
    %10 = dialect_op vector.pack_lanes(%0, %1, %2, %3) -> <4 x i32>
    %11 = dialect_op vector.extract_lane(%10) -> i32 [vector_ty=ty:<4 x i32>] [lane=u64:2]
    %12 = dialect_op vector.insert_lane(%6, %7) -> <4 x i32> [lane=u64:1]
    %13 = dialect_op vector.pack_lanes(%4, %5) -> <2 x i64>
    %14 = dialect_op vector.extract_lane(%13) -> i64 [vector_ty=ty:<2 x i64>] [lane=u64:1]
    %15 = dialect_op vector.insert_lane(%8, %9) -> <2 x i64> [lane=u64:0]
    %16 = icmp sgt <4 x i32> %12, %10
    %17 = dialect_op vector.mask_to_bits(%16) -> i32 [mask_ty=ty:<4 x bool>] [bit_order=str:"lsb_lane0"]
    %18 = icmp eq <2 x i64> %15, %13
    %19 = dialect_op vector.mask_to_bits(%18) -> i64 [mask_ty=ty:<2 x bool>] [bit_order=str:"lsb_lane0"]
    ret %10, %11, %12, %13, %14, %15, %17, %19
}
