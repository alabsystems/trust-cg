{
  "name": "cnn_with_flatten",
  "inputs": [
    { "name": "input", "shape": [1, 3, 8, 8], "dtype": "f32", "layout": "nchw" }
  ],
  "outputs": ["logits"],
  "tensors": [
    { "name": "conv_out", "shape": [1, 4, 8, 8], "dtype": "f32", "layout": "nchw" },
    { "name": "flat", "shape": [1, 256], "dtype": "f32", "layout": "nc" },
    { "name": "logits", "shape": [1, 10], "dtype": "f32", "layout": "nc" }
  ],
  "initializers": [
    { "name": "conv.weight", "shape": [4, 3, 3, 3], "dtype": "f32", "layout": "oihw", "values": [0.1] },
    { "name": "conv.bias", "shape": [4], "dtype": "f32", "layout": "vector", "values": [0.0] },
    { "name": "fc.weight", "shape": [10, 256], "dtype": "f32", "layout": "oi", "values": [0.2] },
    { "name": "fc.bias", "shape": [10], "dtype": "f32", "layout": "vector", "values": [0.0] }
  ],
  "nodes": [
    {
      "name": "Conv_0",
      "op_type": "Conv",
      "inputs": ["input", "conv.weight", "conv.bias"],
      "outputs": ["conv_out"],
      "attributes": { "kernel_shape": [3, 3], "strides": [1, 1], "pads": [1, 1, 1, 1] }
    },
    {
      "name": "Flatten_1",
      "op_type": "Flatten",
      "inputs": ["conv_out"],
      "outputs": ["flat"],
      "attributes": { "axis": 1 }
    },
    {
      "name": "Gemm_2",
      "op_type": "Gemm",
      "inputs": ["flat", "fc.weight", "fc.bias"],
      "outputs": ["logits"],
      "attributes": { "alpha": 1.0, "beta": 1.0, "transB": 1 }
    }
  ]
}
