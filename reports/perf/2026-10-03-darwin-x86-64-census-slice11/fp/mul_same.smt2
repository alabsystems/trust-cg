(set-logic QF_BVFP)
(declare-const x (_ BitVec 32))
(declare-const y (_ BitVec 32))
(declare-const s (_ FloatingPoint 8 24))
(declare-const m (_ FloatingPoint 8 24))
(assert (= s (fp.mul RNE ((_ to_fp 8 24) x) ((_ to_fp 8 24) y))))
(assert (= m (fp.mul RNE ((_ to_fp 8 24) x) ((_ to_fp 8 24) y))))
(assert (not (= s m)))
(check-sat)
