; TrustIr text format v1
module "tcg_rich"

functy.0 = () -> (u64)
functy.1 = (u64) -> (u64)

global mut align(8) @tcg_val u64 = 42
global @tcg_tab ptr = symaddr<tcg_get>
global tls(general_dynamic) mut align(8) @tcg_tls u64 = 7
global external mut @c_word u64

fn @c_cb(functy.1) {
}

fn @tcg_get(functy.0) {
bb0:
    %0 = global_addr @global.0
    %1 = load u64, ptr %0
    ret %1
}

fn @tcg_bump(functy.0) {
bb0:
    %0 = global_addr @global.0
    %1 = load u64, ptr %0
    %2 = const u64 1
    %3 = add u64 %1, %2
    store u64 %3, ptr %0
    ret %3
}

fn @tcg_call(functy.0) {
bb0:
    %0 = global_addr @global.1
    %1 = load ptr, ptr %0
    %2 = call_indirect %1(functy.0)()
    ret %2
}

fn @tcg_tls_bump(functy.0) {
bb0:
    %0 = global_addr @global.2
    %1 = load u64, ptr %0
    %2 = const u64 1
    %3 = add u64 %1, %2
    store u64 %3, ptr %0
    ret %3
}

fn @tcg_cb(functy.0) {
bb0:
    %0 = const u64 5
    %1 = call @func.0(%0)
    ret %1
}

fn @tcg_cword(functy.0) {
bb0:
    %0 = global_addr @global.3
    %1 = load u64, ptr %0
    ret %1
}
