{
  "name": "supported_conv_bn_relu",
  "inputs": [
    {
      "name": "input",
      "shape": [1, 3, 32, 32],
      "dtype": "f32",
      "layout": "nchw"
    }
  ],
  "outputs": ["relu_out"],
  "tensors": [
    {
      "name": "conv_out",
      "shape": [1, 16, 32, 32],
      "dtype": "f32",
      "layout": "nchw"
    },
    {
      "name": "bn_out",
      "shape": [1, 16, 32, 32],
      "dtype": "f32",
      "layout": "nchw"
    },
    {
      "name": "relu_out",
      "shape": [1, 16, 32, 32],
      "dtype": "f32",
      "layout": "nchw"
    }
  ],
  "initializers": [
    {
      "name": "conv.weight",
      "shape": [16, 3, 3, 3],
      "dtype": "f32",
      "layout": "oihw",
      "values": [0.1]
    },
    {
      "name": "conv.bias",
      "shape": [16],
      "dtype": "f32",
      "layout": "vector",
      "values": [0.0]
    },
    {
      "name": "bn.scale",
      "shape": [16],
      "dtype": "f32",
      "layout": "vector",
      "values": [1.0]
    },
    {
      "name": "bn.bias",
      "shape": [16],
      "dtype": "f32",
      "layout": "vector",
      "values": [0.0]
    },
    {
      "name": "bn.mean",
      "shape": [16],
      "dtype": "f32",
      "layout": "vector",
      "values": [0.0]
    },
    {
      "name": "bn.var",
      "shape": [16],
      "dtype": "f32",
      "layout": "vector",
      "values": [1.0]
    }
  ],
  "nodes": [
    {
      "name": "Conv_0",
      "op_type": "Conv",
      "inputs": ["input", "conv.weight", "conv.bias"],
      "outputs": ["conv_out"],
      "attributes": {
        "kernel_shape": [3, 3],
        "strides": [1, 1],
        "pads": [1, 1, 1, 1]
      }
    },
    {
      "name": "BatchNormalization_1",
      "op_type": "BatchNormalization",
      "inputs": ["conv_out", "bn.scale", "bn.bias", "bn.mean", "bn.var"],
      "outputs": ["bn_out"],
      "attributes": {
        "epsilon": 0.00001,
        "momentum": 0.9
      }
    },
    {
      "name": "Relu_2",
      "op_type": "Relu",
      "inputs": ["bn_out"],
      "outputs": ["relu_out"]
