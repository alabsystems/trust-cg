# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# Rust
target/
# A `target` symlink and its Spotlight-excluded `target.noindex/` build
# directory (this Mac's layout). Both must be ignored, or the Darwin floor's
# source fingerprint hashes the build output and reports a source change
# during the run.
/target
/target.noindex/
# Cargo.lock is committed: trust-cg's dependency revs (notably trust-ir) are
# pinned for cross-repo reproducibility with ty/trust-mc (shared-core alignment).
**/*.rs.bk
# Editor / patch-tool leftovers (a failed `git apply` leaves *.orig / *.rej;
# *.bak files have been committed to this repo twice by accident).
*.bak
*.orig
*.rej
# cargo-fuzz run output next to the fuzz/ manifest. Curated repros live in
# the TRACKED fuzz/repros/ tree (see fuzz/repros/README.md), which is NOT ignored.
/fuzz/corpus/
/fuzz/artifacts/

# SAT-Comp 2026 starexec_build artefact directory (binary is rebuilt
# from source by `./starexec_build`; never committed).
/bin/

# C++
*.o
*.out
*.exe
build/

# Benchmark outputs
benchmarks/**/results/
# reports/perf/run_bench.sh raw output (the reviewed snapshot is the tracked
# reports/perf/results.csv, copied out by hand).
/reports/perf/results/
benchmarks/**/logs/
benchmarks/**/data/

# Evidence payloads stay out of tree: a committed development record is its
# README narrative with identities and hashes, plus its reproducer sources
# (docs/linux-aarch64-completion.md, "Durable evidence policy"). Logs,
# captures, JSON and inventories of a dated record are not added. The
# prerequisites record keeps its payload (scripts/gate_env.sh reads it). The
# step-0 oracles record keeps its report's LaTeX source, which is the
# narrative itself, not a payload. Test fixtures live under
# scripts/tests/fixtures/.
/reports/20*/**
/reports/perf/20*/**
!/reports/20*/**/
!/reports/perf/20*/**/
!/reports/**/*.md
!/reports/**/*.rs
!/reports/**/*.c
!/reports/**/*.cc
!/reports/**/*.cpp
!/reports/**/*.h
!/reports/**/*.py
!/reports/**/*.sh
!/reports/**/*.s
!/reports/**/*.S
!/reports/**/*.ll
!/reports/**/*.lean
!/reports/**/*.smt2
!/reports/**/*.patch
!/reports/**/*.toml
!/reports/**/*.trust_ir
!/reports/**/*.trust-ir
!/reports/2026-09-10-soundness-prerequisites/**
!/reports/2026-09-29-step0-oracles/latex/*.tex
reports/**/records/
reports/**/*.tar.gz
docs/archive/session-reports/**/*.gz
# The acceptance record archives its payloads in tree (acceptance template rule 2).
!reports/acceptance/**/records/
!reports/acceptance/**/*.tar.gz
!reports/acceptance/**/*.o

# Emacs
*~
\#*\#
.#*

# Credentials and secrets
.env
.env.*
*.key
*.pem
*.p12
*.pfx
credentials.json
secrets.json
*_secret*
*.secret
.secrets/

# Mutation testing artifacts
mutants/
.mutmut-cache/
kani_status.json

# Local agent/editor configuration
.claude/
.mcp.json

# Explicit development-only Cargo source redirects. The tracked example records
# the expected sibling layout; the active config must never become repository
# dependency authority.
/.cargo/local-siblings.toml

# Trust compiler Internal Compiler Error dumps (transient; never commit)
rustc-ice-*.txt
trustc-ice-*.txt

# external CARGO_TARGET_DIR used for the bridge dylib differential gate.
# The canonical build convention is
#   cd crates/rustc-codegen-trust-cg && CARGO_TARGET_DIR=target-bridge cargo build --release
# so the dir appears BOTH at the repo root (older worktree-based recipe) and
# under the bridge crate. Anchoring only the root left the canonical one
# untracked-but-not-ignored, polluting `git status` and risking an accidental
# commit of a multi-hundred-MB build tree.
/target-bridge/
target-bridge/

# Lean build artifacts (formal/ forward-sim development)
/formal/lean/.lake/
/formal/lean/build/
*.olean

# publish.sh work area (export tree, guard reports, staging clone)
publish/.out/

# Session scratch work area (untracked temp files; never commit)
# Fuzzer repro programs are source-controlled regression fixtures (fuzz/repros/).
/scratchpad/

# Raw eval RUN OUTPUT (scripts/run_panic_fuzz_evidence.sh, the per-test
# logs). Nothing under here has
# ever been tracked, and the ratchet's own instruction is to COPY a result out
# to a reviewed baseline (`cp evals/results/tests/<date>.json <baseline>`) —
# which is what gets committed. The raw tree is scratch.
#
# Not cosmetic: hooks/pre-push refuses on `git status --porcelain`, which counts
# UNTRACKED files, so a developer who ran either script could never push main
# again until they deleted the output by hand. Measured — that is exactly what
# this clone was in.
/evals/results/

# Verification build output (channel=trust default lane)
target-verify/
# A `RUSTC=<trust stage2>/bin/trustc` build of the root workspace, used to run
# `regen_verdict_db` with an ADMITTED AY (the stock-built tree records no
# toolchain AY identity, so it cannot).
target-trustregen/
