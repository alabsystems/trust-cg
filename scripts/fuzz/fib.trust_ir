; trust_ir text format v1
module "fibkern"

functy.0 = (i32) -> (i32)

fn @fib_kernel(functy.0) {
bb0(%0: i32):
    %1 = const i32 1
    %2 = const i32 0
    %3 = const i32 1
    %4 = const i32 0
    br bb1(%4, %2, %3)
bb1(%5: i32, %6: i32, %7: i32):
    %8 = icmp slt i32 %5, %0
    condbr %8, bb2(%5, %6, %7), bb3(%7)
bb2(%9: i32, %10: i32, %11: i32):
    %12 = add i32 %10, %11
    %13 = add i32 %9, %1
    br bb1(%13, %11, %12)
bb3(%14: i32):
    ret %14
}
